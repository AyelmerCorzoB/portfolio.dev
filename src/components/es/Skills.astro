---
const skillColors: { [key: string]: string } = {
  HTML5: "hover:bg-gradient-to-r from-[#E34F26] to-[#F06529] hover:text-white",
  CSS3: "hover:bg-gradient-to-r from-[#1572B6] to-[#33A9DC] hover:text-white",
  JavaScript: "hover:bg-gradient-to-r from-[#b5a735] to-[#F0DB4F] hover:text-black",
  Astro: "hover:bg-gradient-to-tr from-[#1321AC] to-[#881ABD] hover:text-white",
  "Tailwind CSS": "hover:bg-gradient-to-tr from-[#177080] to-[#a5f3fc] hover:text-black",
  "Node.js": "hover:bg-gradient-to-r from-[rgba(48,48,48,0.3)] to-[rgb(60,135,58)] hover:text-white",
  Python: "hover:bg-gradient-to-r from-[#3776AB] to-[#FFD43B] hover:text-black",
  PHP: "hover:bg-gradient-to-r from-[#777BB4] to-[#AEB2D5] hover:text-black",
  MySQL: "hover:bg-[#4479A1] hover:text-white",
  PostgreSQL: "hover:bg-gradient-to-r from-[#00758F] to-[#F29111] hover:text-white",
  Java: "hover:bg-gradient-to-r from-[#DE3423] to-[#380D09] hover:text-white",
  "Power Bi Desktop": "hover:bg-gradient-to-r from-[#F2C811] to-[#333333] hover:text-black",
  Git: "hover:bg-[#F05032] hover:text-white",
  GitHub: "hover:bg-[#181717] hover:text-white",
  "VS Code": "hover:bg-[#007ACC] hover:text-white",
  Figma: "hover:bg-gradient-to-r from-[#18A0FB] via-[#1BC47D] to-[#F24E1E] hover:text-white",
  "Responsive Design": "hover:bg-[#1B73E8] hover:text-white",
  "Spring Boot": "hover:bg-gradient-to-r from-[rgba(48,48,48,0.3)] to-[rgb(60,135,58)] hover:text-white",
};

const skills = [
  {
    category: "Frontend",
    items: ["HTML5", "CSS3", "JavaScript", "Astro", "Tailwind CSS"],
  },
  {
    category: "Backend",
    items: ["Node.js", "Python", "PHP", "MySQL", "PostgreSQL", "Java", "Spring Boot"],
  },
  {
    category: "Herramientas y Otros",
    items: ["Power Bi Desktop", "Git", "GitHub", "VS Code", "Figma", "Responsive Design"],
  },
];
---


<section id="skills" class="py-20">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        skills.map((skillGroup) => (
          <div class="group bg-white/70 dark:bg-gray-800/60 backdrop-blur-md rounded-2xl border border-green-500/20 shadow-lg p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
            
            <h3 class="text-xl font-semibold mb-6 text-green-500 dark:text-green-400 relative inline-block">
              {skillGroup.category}
              <span class="absolute -bottom-2 left-0 w-1/2 h-[3px] rounded-full bg-green-500 dark:bg-green-400" />
            </h3>

            <div class="flex flex-wrap gap-3">
              {skillGroup.items.map((skill) => (
                <span
                  class={`px-4 py-1.5 rounded-full text-sm font-medium
                  bg-gray-100 dark:bg-gray-700
                  text-gray-800 dark:text-gray-200
                  transition-all duration-300
                  hover:scale-105 hover:shadow-md
                  cursor-default
                  ${skillColors[skill] || "hover:bg-green-500 hover:text-white"}`}
                >
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>


