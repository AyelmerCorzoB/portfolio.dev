---
import ExperienceItem from "./ExperienceItem.astro"
const EXPERIENCE = [
  {
    date: "Noviembre 2024",
    title: "Desarrollador Full Stack",
    company: "Campuslands",
    description:
      "Participé activamente en el desarrollo de una aplicación web, formando parte de los equipos de frontend y backend. Esta experiencia me permitió tener una visión integral del proyecto, asegurando una correcta comunicación e integración entre ambas áreas.",
  },
  {
    date: "Julio 2025 - Enero 2026",
    title: "Auxiliar de Transformación Digital",
    company: "Arroz Gelvez S.A.S",
    description:
      "Realicé mis prácticas del técnico laboral en Programación de Software, apoyando procesos de transformación digital, desarrollo de soluciones internas y mejora de flujos tecnológicos dentro de la empresa.",
  },
  {
    date: "Actualmente",
    title: "Auxiliar de Transformación Digital",
    company: "Inversiones Ciudad S.A.S",
    description:
      "Apoyo en procesos de transformación digital, automatización y desarrollo de soluciones tecnológicas, contribuyendo a la optimización de procesos internos y al fortalecimiento del área de sistemas.",
  },
