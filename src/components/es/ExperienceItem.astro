---
import LinkInline from "./LinkInline.astro";

interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
}

const { title, company, description, link, date } = Astro.props;
const isCurrent = date === "Actualmente";
---

<div
  class={`group relative pl-10 pr-4 py-5 rounded-2xl transition-all duration-300
  ${
    isCurrent
      ? "bg-green-500/10 dark:bg-green-500/15  shadow-[0_0_30px_rgba(34,197,94,0.35)]"
      : "hover:bg-green-500/5"
  }`}
>
  <!-- Timeline connector -->
  <div
    class={`absolute left-0 top-0 bottom-0 w-[2px] transition-opacity duration-300
  ${
    isCurrent
      ? "bg-gradient-to-b from-green-400 via-green-300 to-green-200 opacity-100"
      : "bg-gradient-to-b from-green-400 via-green-300/70 to-transparent opacity-60 group-hover:opacity-100"
  }`}
  >
  </div>

  <!-- Timeline dot -->
  <div
    class={`absolute left-[-6px] top-7 h-4 w-4 rounded-full transition-all duration-300
  ${
    isCurrent
      ? "bg-green-400 ring-8 ring-green-400/30 animate-pulse shadow-[0_0_20px_rgba(34,197,94,0.9)]"
      : "bg-green-400 ring-4 ring-green-400/20 shadow-[0_0_14px_rgba(56,189,248,0.6)] group-hover:scale-125"
  }`}
  >
  </div>

  <div class="flex flex-col md:flex-row gap-6">
    <!-- Left column -->
    <div class="md:w-1/3 space-y-2">
      <time
        class="inline-flex items-center gap-2 text-xs font-semibold tracking-wide text-green-700 dark:text-green-300 bg-green-100/70 dark:bg-green-900/40 px-3 py-1 rounded-full"
      >
        {date}

        {
          isCurrent && (
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-green-500 text-white tracking-widest animate-pulse">
              ACTUAL
            </span>
          )
        }
      </time>

      <h4
        class="text-lg font-semibold text-zinc-800 dark:text-white transition-colors duration-300 group-hover:text-green-500"
      >
        {company}
      </h4>
    </div>

    <!-- Right column -->
    <div class="md:w-2/3 space-y-4">
      <h3
        class={`text-xl font-bold
  ${
    isCurrent
      ? "text-green-600 dark:text-green-400"
      : "text-green-500 dark:text-green-400"
  }`}
      >
        {title}
      </h3>

      <p class="text-zinc-600 dark:text-zinc-300 leading-relaxed">
        {description}
      </p>

      {
        link && (
          <LinkInline
            href={link}
            class="group/link inline-flex items-center gap-1 text-green-500 dark:text-green-400 font-medium transition-all duration-300 hover:text-green-400"
          >
            Saber más
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 transition-transform duration-300 group-hover/link:translate-x-1"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" />
              <path d="M9 6l6 6l-6 6" />
            </svg>
          </LinkInline>
        )
      }
    </div>
  </div>
</div>
