---
const personalImageAlt = "Ayelmer Corzo";
import LinkedInIcon from "../../components/icons/LinkedIn.astro";
import MailIcon from "../../components/icons/Mail.astro";
import SocialPill from "./SocialPill.astro";
---

<section class="relative overflow-hidden">
  <!-- Fondo futurista -->
  <div
    class="absolute inset-0 -z-10"
  >
  </div>

  <div class="max-w-4xl mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center justify-between gap-10">
      <!-- Texto -->
      <div class="flex-1 space-y-6 text-center md:text-left">
        <!-- Badge disponibilidad -->
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-green-100/80 dark:bg-green-900/30 border border-green-300/40 dark:border-green-900/40 backdrop-blur-sm"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span
              class="absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75 animate-ping"
            ></span>
            <span
              class="relative inline-flex h-2.5 w-2.5 rounded-full bg-red-500"
            ></span>
          </span>
          <a
            href="https://linkedin.com/in/ayelmercorzob"
            target="_blank"
            rel="noopener"
            class="text-sm font-medium text-green-800 dark:text-green-200"
          >
            No disponible
          </a>
        </div>

        <!-- Título -->
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white"
        >
          Hola, soy
          <span
            class="py-1 block text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-green-600 dark:from-green-300 dark:to-green-500"
          >
            AyelmerDev
          </span>
        </h1>

        <!-- Descripción -->
        <p
          class="text-lg sm:text-xl text-gray-900 dark:text-gray-300 max-w-2xl mx-auto md:mx-0 leading-relaxed"
        >
          <strong class="font-semibold text-green-600 dark:text-green-300"
            >Desarrollador Web FullStack</strong
          >
          actualmente en
          <strong class="font-semibold text-green-600 dark:text-green-300">
            Arroz Gelvez</strong
          >, creando soluciones digitales con código limpio y experiencias de
          usuario modernas.
        </p>

        <!-- Botones -->
        <div class="flex flex-wrap justify-center md:justify-start gap-4 pt-4">
          <SocialPill
            href="mailto:corzobarbosaa@gmail.com"
            class="transition-all duration-300 hover:scale-105 hover:shadow-lg"
          >
            <div class="flex items-center gap-2 text-gray-900 dark:text-white">
              <MailIcon class="size-5" />
              <span>Contáctame</span>
            </div>
          </SocialPill>

          <SocialPill
            href="https://linkedin.com/in/ayelmercorzob"
            class="transition-all duration-300 hover:scale-105 hover:shadow-lg"
          >
            <div class="flex items-center gap-2 text-gray-900 dark:text-white">
              <LinkedInIcon class="size-5" />
              <span>LinkedIn</span>
            </div>
          </SocialPill>
        </div>
      </div>

      <div class="relative w-40 h-40 sm:w-48 sm:h-48 md:w-56 md:h-56">
        <!-- Contenedor principal con borde y sombra -->
        <div
          class="absolute inset-0 rounded-full border-4 border-white dark:border-gray-800 shadow-xl overflow-hidden"
        >
          <!-- Fondo con efecto de gradiente y animación -->
          <div
            class="absolute inset-0 bg-gradient-to-r from-green-100 to-green-200 opacity-70 dark:from-green-900/20 dark:to-green-800/20 dark:opacity-50 animate-pulse"
          >
          </div>
          <!-- Imagen -->
          <img
            class="absolute inset-0 w-full h-full object-cover transform transition-transform duration-300 hover:scale-110"
            src="/images/image05.jpg"
            alt={personalImageAlt}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  .relative > div:first-child {
    animation: float 6s ease-in-out infinite;
  }
</style>
