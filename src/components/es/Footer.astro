---
const currentYear = new Date().getFullYear();
---

<footer
  class="opacity-90 mt-20 mb-10 w-full flex justify-center px-4"
>
  <div
    class="w-full max-w-4xl flex flex-col gap-4 md:flex-row md:items-center md:justify-between
    rounded-xl px-6 py-4
    bg-white/60 dark:bg-zinc-900/60
    backdrop-blur-md border border-green-400/20 shadow-lg"
  >
    <!-- Copyright -->
    <span
      class="text-xs md:text-sm text-zinc-700 dark:text-zinc-300 tracking-wide"
    >
      © {currentYear}
      <a
        href="https://github.com/AyelmerCorzoB"
        target="_blank"
        class="text-green-500 hover:text-green-400 transition-colors duration-300 font-medium"
      >
        AyelmerDev
      </a>
       · Todos los derechos reservados
    </span>

    <!-- Links -->
    <ul
      class="flex flex-wrap items-center gap-4 text-sm font-medium"
    >
      <li>
        <a
          href="https://github.com/AyelmerCorzoB/portfolio.dev"
          target="_blank"
          class="group relative text-green-500 hover:text-green-400 transition-all duration-300"
        >
          Repo Portfolio
          <span
            class="absolute -bottom-1 left-0 h-[1px] w-0 bg-green-400/80 transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
      </li>

      <li>
        <a
          href="mailto:corzobarbosaa@gmail.com"
          class="group relative text-green-500 hover:text-green-400 transition-all duration-300"
        >
          Contacto
          <span
            class="absolute -bottom-1 left-0 h-[1px] w-0 bg-green-400/80 transition-all duration-300 group-hover:w-full"
          ></span>
        </a>
      </li>
    </ul>
  </div>
</footer>

